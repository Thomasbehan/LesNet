<!DOCTYPE html>
<html lang="{{ request.locale_name }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="LesNet">
    <meta name="author" content="LesNet">
    <link rel="shortcut icon" href="{{ request.static_url('skinvestigatorai:static/min/logo-16x16.png') }}">
    <title>LesNet</title>

    <!-- Fonts and Bootstrap -->
    <link rel="stylesheet" href="//maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

    <!-- Custom styles -->
    <style>
      body {
        font-family: Roboto;
        background-color: #e9f1fc;
      }
      .sidebar {
        background-color: #d6e4f7;
        padding-top: 20px;
      }
      .sidebar h4 {
        text-align: center;
        font-weight: bold;
      }
      .sidebar a {
        color: #333;
        display: block;
        padding: 10px 20px;
        text-decoration: none;
      }
      .sidebar a:hover {
        background-color: #e9f1fc;
        border-radius: 5px;
      }
      .main-content {
        padding: 20px;
      }
      .right-panel {
        background-color: #ffffff;
        border-radius: 10px;
        box-shadow: 0px 4px 6px rgba(0, 0, 0, 0.1);
        padding: 20px;
      }
      .logo {
        width: 100%;
      }
      /* Hamburger Menu Styles */
      .navbar-toggler {
        border: none;
      }
      .card {
        background-color: #ffffff;
      }
      @media (min-width: 768px) {
        .navbar-toggler {
          display: none; /* Hide on larger screens */
        }
      }
    </style>
    <link rel="stylesheet" href="{{ request.static_url('skinvestigatorai:static/css/file-upload.css') }}">
  </head>

  <body>
    <!-- Navbar for Hamburger Menu -->
    <nav class="navbar navbar-light bg-light d-md-none">
      <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
    </nav>

    <div class="container-fluid">
      <div class="row">
        <!-- Sidebar -->
        <div class="col-md-2 sidebar d-none d-md-block">
          <a href="/"><img class="logo img-responsive" src="{{request.static_url('skinvestigatorai:static/logo-with-text.png') }}" alt="LesNet"></a>
          <hr/>
          <a href="/">Image Analyser</a>
          <a href="/supported-diagnoses">Supported Diagnoses</a>
          <hr/>
          <a href="#">GitHub Project</a>
          <a href="#">Vote on Features</a>
          <a href="#">Documentation</a>
          <hr/>
          <a href="#">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="explicitToggle" checked>
                <label class="form-check-label" for="explicitToggle">Hide Explicit Imagery</label>
              </div>
          </a>
          <!--<button class="btn btn-primary w-100 mt-3">Upgrade</button>-->
        </div>

        <!-- Collapsible Sidebar for Mobile -->
        <div class="col-md-2 sidebar collapse d-md-none" id="navbarNav">
          <a href="/"><img class="logo img-responsive" src="{{request.static_url('skinvestigatorai:static/logo-with-text.png') }}" alt="LesNet"></a>
          <hr/>
          <a href="/">Image Analyser</a>
          <a href="/supported-diagnoses">Supported Diagnoses</a>
          <hr/>
          <a href="#">GitHub Project</a>
          <a href="#">Vote on Features</a>
          <a href="#">Documentation</a>
          <hr/>
          <a href="#">
              <div class="form-check form-switch">
                <input class="form-check-input" type="checkbox" id="explicitToggle" checked>
                <label class="form-check-label" for="explicitToggle">Hide Explicit Imagery</label>
              </div>
          </a>
        </div>

        <!-- Main Content -->
        <div class="col-md-10 main-content">
          {% block content %}
          {% endblock %}
        </div>

      </div>
    </div>

    <!-- Scripts -->
    {% block scripts %}
    <script src="//code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="//maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>

    <script src="{{ request.static_url('skinvestigatorai:static/js/file-upload.js') }}"></script>

    {% endblock %}

  </body>
</html>
