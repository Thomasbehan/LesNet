{% extends "layout.jinja2" %}

{% block content %}
<div class="dashboard-header mb-4">
  <h1>Welcome to LesNet</h1>
  <p>Your AI-powered assistant for medical image analysis.</p>
</div>

<div class="row">
  <!-- Upload Section -->
  <div class="col-md-8">
    <div class="card mb-4 p-4 shadow-sm">
      <h5>Upload an Image for Analysis</h5>
      <form id="upload-form" method="post" enctype="multipart/form-data">
        <input type='file' name='image' id='image' accept='image/*' required>
        <button type='submit' class='btn btn-primary mt-3'>Analyze Image</button>
      </form>

      <!-- Loading Indicator -->
      <div id='loading' style='display: none;' class='mt-3'>
        Analyzing image... Please wait.
      </div>

      <!-- Results Container -->
      <div id='response-data' class='result mt-3'></div>
    </div>

    <!-- Diagnosis Information -->
    <div class="card mb-4 p-3 shadow-sm">
      <h5>Diagnosis Information</h5>
      {% if prediction %}
        {% if prediction == "benign" %}
          The lesion appears benign. Continue monitoring for changes.
        {% else %}
          This lesion may be malignant. Consult a dermatologist for further evaluation.
        {% endif %}
      {% else %}
        Upload an image to get started.
      {% endif %}
    </div>
  </div>

  <!-- Statistics & Analysis Details -->
  <div class="col-md-4">
    <div class="card mb-4 p-4 shadow-sm text-center">
      <h5>Statistics</h5>
      <canvas id="probabilityChart" width="400" height="200"></canvas>
    </div>

    <div class="card mb-4 p-3 shadow-sm">
      <h5>Latest Analysis</h5>
      <p><strong>Case:</strong> Skin Lesion - Melanoma Detection</p>
      <p><strong>Date:</strong> {{ current_date }}</p>
      {% if prediction %}
        <p><strong>Result:</strong> {{ confidence|round(2) }}% confidence it is {{ prediction }}</p>
      {% else %}
        <p>No analysis available yet.</p>
      {% endif %}
    </div>
  </div>
</div>



<style>
/* Custom Styles */
body {
  font-family: 'Inter', sans-serif;
}
.card {
  border-radius: 10px;
}
.result {
  background-color: #e9ecef;
  padding: 10px;
  border-radius: 5px;
}
#loading {
  font-weight: bold;
}
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// Handle form submission with AJAX
document.getElementById('upload-form').addEventListener('submit', function(event) {
  event.preventDefault(); // Prevent default form submission

  const formData = new FormData(this); // Gather form data
  const loadingIndicator = document.getElementById('loading');
  const responseData = document.getElementById('response-data');

  // Show loading indicator
  loadingIndicator.style.display = 'block';
  responseData.innerHTML = ''; // Clear previous results

  // Make AJAX request
  fetch("{{ request.route_url('predict') }}", {
    method: 'POST',
    body: formData,
    headers: {
      'X-Requested-With': 'XMLHttpRequest'
    }
  })
    .then(response => {
      if (!response.ok) {
        throw new Error('Network response was not ok');
      }
      return response.json(); // Parse JSON response
    })
    .then(data => {
      // Hide loading indicator
      loadingIndicator.style.display = 'none';

      // Display results dynamically
      if (data.prediction && data.confidence) {
        responseData.innerHTML = `
          <strong>Result:</strong> ${data.confidence.toFixed(2)}% confidence it is ${data.prediction}.
        `;

        // Update Probability Chart
        updateProbabilityChart(data.confidence, data.prediction);
      } else {
        responseData.innerHTML = `<span>No valid result returned. Please try again.</span>`;
      }
    })
    .catch(error => {
      // Hide loading indicator and show error message
      loadingIndicator.style.display = 'none';
      responseData.innerHTML = `<span style="color:red;">An error occurred: ${error.message}</span>`;
    });
});

// Update Probability Chart
function updateProbabilityChart(confidence, prediction) {
  const ctx = document.getElementById('probabilityChart').getContext('2d');

  new Chart(ctx, {
    type: 'doughnut',
    data: {
      labels: ['Confidence', 'Remaining'],
      datasets: [{
        label: 'Probability',
        data: [confidence, 100 - confidence],
        backgroundColor: ['#007bff', '#e9ecef'],
        borderWidth: 1,
      }]
    },
    options: {
      responsive: true,
      plugins: {
        legend: {
          position: 'top',
        },
        tooltip: {
          callbacks: {
            label(context) {
              return `${context.label}: ${context.raw.toFixed(2)}%`;
            }
          }
        }
      }
    }
  });
}
</script>

{% endblock content %}
