{% extends "layout.jinja2" %}

{% block content %}
<!-- Upload view -->
<section class="view active" id="view-upload">
  <div class="lede">
    <img class="hero-logo" src="{{ request.static_url('lesnet:static/min/logo.png') }}" alt="LesNet">
    <h1>Understand your skin.</h1>
    <p class="tagline">Upload a dermoscopic photo for instant, cautious triage guidance and its most likely diagnoses.</p>
    <div class="cta-row">
      <button type="button" class="cta" id="browse-btn">Upload a photo</button>
      <button type="button" class="cta ghost" id="camera-btn">Use camera</button>
    </div>
    <p class="hint">or drop an image anywhere</p>
  </div>
  <form id="upload-form" enctype="multipart/form-data" hidden>
    <input type="file" id="image" name="image" accept="image/*">
    <input type="file" id="camera" accept="image/*" capture="environment">
  </form>
</section>

<!-- Result view -->
<section class="view resultview" id="view-result">
  <button class="back-btn" id="back-btn"><i class="fas fa-arrow-left"></i> New photo</button>
  <div class="result-wrap">
    <div class="shot" id="preview-container">
      <img id="preview-image" alt="Selected lesion">
      <div class="scan"></div>
    </div>
    <div>
      <div id="loading" class="analyzing" style="display:none;"><div class="ring"></div><span>Analysing…</span></div>
      <div id="analysis-result"></div>
    </div>
  </div>
</section>

<!-- Drop-anywhere veil -->
<div class="dropveil" id="dropveil" aria-hidden="true">
  <div class="ring2"><i class="fas fa-arrow-down"></i></div>
  <p>Drop to analyse</p>
</div>

<script src="{{ request.static_url('lesnet:static/js/file-upload.js') }}"></script>
{% endblock content %}
