<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="description" content="LesNet checks a photo of a skin spot and suggests whether it is worth showing to a clinician. A research tool, not a diagnosis.">
    <meta name="theme-color" content="#F5F8F7" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0F1A17" media="(prefers-color-scheme: dark)">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ request.static_url('lesnet:static/favicon-32.png') }}">
    <link rel="apple-touch-icon" href="{{ request.static_url('lesnet:static/apple-touch-icon.png') }}">
    <title>{% block title %}LesNet — skin spot check{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:wght@400;600;700;800&display=swap">
    <link rel="stylesheet" href="{{ request.static_url('lesnet:static/css/lesnet.css') }}">
  </head>
  <body class="{% block body_class %}{% endblock %}">
    <a class="skip" href="#main">Skip to content</a>
    <header class="bar">
      <a class="brand" href="/" aria-label="LesNet home">
        <img src="{{ request.static_url('lesnet:static/logo-96.png') }}" alt="" width="32" height="32">
        <span>LesNet</span>
      </a>
      <nav class="nav" aria-label="Main">
        <a href="/" {% if request.matched_route and request.matched_route.name == 'home' %}aria-current="page"{% endif %}>Check a spot</a>
        <a href="/supported-diagnoses" {% if request.matched_route and request.matched_route.name == 'supported-diagnoses' %}aria-current="page"{% endif %}>Spot types</a>
        <a href="https://github.com/Thomasbehan/LesNet" rel="noopener">Source</a>
      </nav>
    </header>

    <main id="main">
      {% block content %}{% endblock %}
    </main>

    <footer class="foot">
      <p><strong>LesNet is a research tool, not a diagnostic device.</strong> It cannot tell you whether a spot is
        cancer. If a spot is new, changing, bleeding, itchy or worrying you, see a doctor or dermatologist whatever
        this page says.</p>
      <p class="foot-meta">Open source under MPL-2.0. <a href="https://github.com/Thomasbehan/LesNet" rel="noopener">Read the code and the model card on GitHub</a>.</p>
    </footer>

    {% block scripts %}{% endblock %}
  </body>
</html>
