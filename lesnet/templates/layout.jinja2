<!DOCTYPE html>
<html lang="{{ request.locale_name }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#2f6bff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0a0f1a" media="(prefers-color-scheme: dark)">
    <meta name="description" content="LesNet — self-supervised skin-lesion triage">
    <meta name="author" content="LesNet">
    <link rel="shortcut icon" href="{{ request.static_url('lesnet:static/min/logo-16x16.png') }}">
    <title>LesNet</title>

    <!-- Fonts and Bootstrap (Bootstrap retained for secondary pages; modern.css overrides) -->
    <link rel="stylesheet" href="//maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" />

    <!-- Single minimal stylesheet -->
    <link rel="stylesheet" href="{{ request.static_url('lesnet:static/css/modern.css') }}">
  </head>

  <body>
    <!-- Aurora background + cursor spotlight + vignette -->
    <div class="bg-strips" aria-hidden="true">
      <div class="strips">
        <span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>
    <div class="spotlight" aria-hidden="true"></div>
    <div class="vignette" aria-hidden="true"></div>

    <!-- Minimal top bar -->
    <header class="topbar">
      <a class="brand" href="/">
        <img src="{{ request.static_url('lesnet:static/min/logo.png') }}" alt="LesNet">
      </a>
      <nav class="topnav">
        <a href="/supported-diagnoses">Diagnoses</a>
        <a target="_blank" href="https://github.com/Thomasbehan/LesNet"><i class="fab fa-github"></i></a>
      </nav>
    </header>

    <!-- Navbar for Hamburger Menu -->
    <nav class="navbar navbar-light bg-light d-md-none">
      <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
    </nav>

    <div class="container-fluid">
      <div class="row">
        <!-- Sidebar -->
        <div class="col-md-2 sidebar d-none d-md-block">
          <a href="/"><img class="logo img-responsive" src="{{request.static_url('lesnet:static/logo-with-text.png') }}" alt="LesNet"></a>
          <hr/>
          <a href="/"><i class="fas fa-image"></i> Image Analyser</a>
          <a href="/supported-diagnoses"><i class="fas fa-stethoscope"></i> Supported Diagnoses</a>
          <hr/>
          <a target="_blank" href="https://github.com/Thomasbehan/LesNet"><i class="fab fa-github"></i> GitHub Project</a>
          <a target="_blank" href="https://github.com/Thomasbehan/LesNet/discussions/categories/polls"><i class="fas fa-vote-yea"></i> Vote on Features</a>
          <a target="_blank" href="https://github.com/Thomasbehan/LesNet/wiki"><i class="fas fa-book"></i> Documentation</a>
          <hr/>
          <a href="#">
            <label class="switch">
                <input type="checkbox" id="explicitToggle" checked>
                <span class="slider"></span>
                <span class="label-text">Hide Explicit Imagery</span>
            </label>
          </a>
          <!--<button class="btn btn-primary w-100 mt-3">Upgrade</button>-->
        </div>

        <!-- Collapsible Sidebar for Mobile -->
        <div class="col-md-2 sidebar collapse d-md-none" id="navbarNav">
          <a href="/"><img class="logo img-responsive" src="{{request.static_url('lesnet:static/logo-with-text.png') }}" alt="LesNet"></a>
          <hr/>
          <a href="/"><i class="fas fa-image"></i>Image Analyser</a>
          <a href="/supported-diagnoses"><i class="fas fa-stethoscope"></i> Supported Diagnoses</a>
          <hr/>
          <a target="_blank" href="https://github.com/Thomasbehan/LesNet"><i class="fab fa-github"></i> GitHub Project</a>
          <a target="_blank" href="https://github.com/Thomasbehan/LesNet/discussions/categories/polls"><i class="fas fa-vote-yea"></i> Vote on Features</a>
          <a target="_blank" href="https://github.com/Thomasbehan/LesNet/wiki"><i class="fas fa-book"></i> Documentation</a>
          <hr/>
          <a href="#">
            <label class="switch">
                <input type="checkbox" id="explicitToggle" checked>
                <span class="slider"></span>
                <span class="label-text">Hide Explicit Imagery</span>
            </label>
          </a>
        </div>

        <!-- Main Content -->
        <div class="col-md-10 main-content">
          {% block content %}
          {% endblock %}
        </div>

      </div>
    </div>

    <!-- Mobile bottom navigation -->
    <nav class="tabbar">
      <a href="/" class="active"><i class="fas fa-wand-magic-sparkles"></i>Analyse</a>
      <a href="/supported-diagnoses"><i class="fas fa-stethoscope"></i>Diagnoses</a>
      <a target="_blank" href="https://github.com/Thomasbehan/LesNet"><i class="fab fa-github"></i>GitHub</a>
    </nav>

    <!-- Scripts -->
    {% block scripts %}

    <script src="//code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="//maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script src="{{ request.static_url('lesnet:static/js/explicit-image-handler.js') }}"></script>

    {% endblock %}

  </body>
</html>
