{% extends "layout.jinja2" %}

{% block title %}What LesNet recognises{% endblock %}

{% block content %}
<div class="page-head">
  <h1>What LesNet recognises</h1>
  <p>LesNet was trained on labelled dermatology photos of the spot types below. When you check a photo, it tells you
    which of these it looks most like. It only knows these types, so anything else, such as a rash, a wound or a
    nail problem, is outside what it can judge.</p>
  <p>Descriptions come from Wikipedia. Tap a name to read more.</p>
</div>

<div class="groups" id="groups" aria-live="polite">
  <p class="dx-empty" id="dx-loading">Loading the list…</p>
</div>
{% endblock content %}

{% block scripts %}
<script src="{{ request.static_url('lesnet:static/js/diagnoses.js') }}" defer></script>
{% endblock %}
